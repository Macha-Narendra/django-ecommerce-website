# This file is a generic template for environment variables.
# Use the specific environment templates below for development or production.
#
# Development:  copy .env.dev.example .env
# Production:   copy .env.prod.example .env
#
# Then update `.env` with your real secret key and deployment values.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-replace-with-output-from-command-above
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
PYTHONUNBUFFERED=1

# PostgreSQL database settings
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ecommerce_pass
DATABASE_NAME=ecommerce
DATABASE_USER=ecommerce_user
DATABASE_PASSWORD=ecommerce_pass
DATABASE_HOST=db
DATABASE_PORT=5432
